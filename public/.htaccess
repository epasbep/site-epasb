# =====================================================
# EPASB-EP — configuração do servidor (Apache)
# =====================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

# Endereços sem .html: /sobre mostra sobre.html, e quem abrir /sobre.html é levado para /sobre.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /pagina.html → /pagina (e /index.html → /)
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index\.html[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # /pagina → pagina.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # Activar só depois de confirmar que o certificado SSL está instalado:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # O painel administrativo nunca deve aparecer em motores de busca
  <If "%{REQUEST_URI} =~ m#^/admin(/|$)#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# Ficheiros sensiveis
<FilesMatch "\.(env|log|ini|bak|sql|config|zip)$">
  Require all denied
</FilesMatch>

# Compressao (poupa dados moveis)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Cache: imagens e logotipos ficam guardados 1 ano; paginas, CSS e JS sao sempre verificados
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
